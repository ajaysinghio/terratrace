{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsconfig.base.json's "lib": ["ES2022"] is scoped for Node-only
    // packages — the dashboard is a browser app too (client components),
    // so it needs DOM types the base config deliberately omits.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }]
  },
  "include": ["src", "next-env.d.ts"],
  "exclude": ["node_modules", ".next", "dist"],
  "references": [{ "path": "../core" }]
}
