{
  "name": "@terratrace/core",
  "version": "0.1.0",
  "description": "Shared domain types and pluggable interfaces for billing, code analysis, LLM reasoning, and carbon math.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./correlate": {
      "types": "./dist/carbon/correlate.d.ts",
      "default": "./dist/carbon/correlate.js"
    }
  },
  "files": [
    "dist",
    "rules-semgrep"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "echo \"(no linter configured for @terratrace/core)\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/openai": "^4.0.46",
    "@aws-sdk/client-s3": "^3.1124.0",
    "ai": "^7.0.73",
    "diff": "^5.2.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-python": "^0.25.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
