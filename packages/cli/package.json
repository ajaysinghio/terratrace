{
  "name": "@terratrace/cli",
  "version": "0.1.0",
  "description": "Runnable end-to-end pipeline: scan Python files for carbon/cost-impacting patterns and explain them with Claude.",
  "type": "module",
  "bin": {
    "terratrace": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "tsc -b && cd ../.. && node packages/cli/dist/index.js",
    "harness": "tsc -b && node dist/harness.js",
    "typecheck": "tsc -b",
    "lint": "echo \"(no linter configured for @terratrace/cli)\""
  },
  "dependencies": {
    "@terratrace/core": "workspace:*",
    "diff": "^5.2.0",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
